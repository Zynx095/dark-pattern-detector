# ── FREE / OPENAI-COMPATIBLE LLM (RECOMMENDED) ───────────
# Use any OpenAI-compatible provider (OpenRouter, Groq, Ollama, DeepSeek, etc.)
# Examples:
# OpenRouter: FREE_LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq:       FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama:     FREE_LLM_BASE_URL=http://localhost:11434/v1
FREE_LLM_API_KEY=your_free_api_key_here
FREE_LLM_BASE_URL=https://api.openai.com/v1
FREE_LLM_MODEL=gpt-4o-mini

# ── OPTIONAL / FALLBACK: GEMINI API ─────────────────────
# GEMINI_API_KEY=paste_your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ── DATABASE ─────────────────────────────────────────────
# Default: SQLite (zero setup, works immediately locally)
DATABASE_URL=sqlite:///./darkpattern.db
